#!/sbin/openrc-run

description="Start the TempDesk portal pair from the appliance publication"

depend() {
    need localmount networking docker
}

compose() {
    timeout 180 docker compose --project-name tempdesk-appliance --project-directory /opt/tempdesk \
        -f /opt/tempdesk/compose.yaml -f /opt/tempdesk/compose.published.yaml \
        -f /opt/tempdesk/compose.appliance.yaml "$@"
}

load_network() {
    IFS= read -r TEMPDESK_PORTAL_DIGEST < /opt/tempdesk/portal-digest || return 1
    {
        IFS= read -r TEMPDESK_LAN_ADDRESS && IFS= read -r source_network
    } < /run/tempdesk-appliance/network || return 1
    export TEMPDESK_PORTAL_DIGEST TEMPDESK_LAN_ADDRESS
}

wait_for_firewall() {
    local attempts=0
    until timeout 2 docker info >/dev/null 2>&1 &&
          iptables -w 2 -S DOCKER-USER >/dev/null 2>&1; do
        attempts=$((attempts + 1))
        if [ "$attempts" -ge 20 ]; then
            eerror "Docker and its DOCKER-USER firewall chain did not become ready."
            return 1
        fi
        sleep 1
    done
}

protect_ports() {
    for port in 8080 8081; do
        set -- -p tcp ! -s "$source_network" -m conntrack --ctdir ORIGINAL \
            --ctorigdst "$TEMPDESK_LAN_ADDRESS" --ctorigdstport "$port" -j DROP
        if ! iptables -w 2 -C DOCKER-USER "$@" 2>/dev/null; then
            iptables -w 2 -I DOCKER-USER 1 "$@" || return 1
        fi
    done
}

import_configuration() {
    local seed=/run/tempdesk-appliance/seed rc=0 devices
    umask 077
    install -d -m 0700 /run/tempdesk-appliance "$seed" || return 1
    if [ ! -e /var/lib/tempdesk/config/deployment.json ]; then
        devices="$(blkid -t LABEL=TD-CONFIG -o device)"
        case "$devices" in
            "") ;;
            *[!a-zA-Z0-9_/-]*)
                eerror "Attach exactly one TempDesk configuration volume."
                return 1 ;;
            *) mount -t ext4 -o ro,noload,nosuid,nodev,noexec "$devices" "$seed" || return 1 ;;
        esac
    fi
    python3 /opt/tempdesk/appliance-config.py || rc=$?
    if mountpoint -q "$seed"; then
        umount "$seed" || return 1
    fi
    return "$rc"
}

start() {
    ebegin "Checking TempDesk appliance configuration"
    local code=0
    import_configuration || code=$?
    case "$code" in
        0) eend 0 ;;
        3) einfo "TEMPDESK_APPLIANCE_WAITING_FOR_CONFIG"; eend 0; return 0 ;;
        4) eerror "The configured LAN address is not assigned to this appliance."; eend 1; return 1 ;;
        *) eend 1; return 1 ;;
    esac
    ebegin "Starting the published TempDesk portals"
    load_network && wait_for_firewall && protect_ports && compose pull --quiet && \
        compose up -d --no-build --pull never --wait --wait-timeout 120 || {
        compose stop --timeout 10 >/dev/null 2>&1
        eend 1
        return 1
    }
    einfo "TempDesk guest portal http://$TEMPDESK_LAN_ADDRESS:8080/"
    einfo "TempDesk management portal http://$TEMPDESK_LAN_ADDRESS:8081/login"
    eend 0
}

stop() {
    [ -f /run/tempdesk-appliance/network ] || return 0
    ebegin "Stopping TempDesk portals"
    load_network && compose stop --timeout 15
    eend $?
}
