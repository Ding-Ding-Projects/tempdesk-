# Admin console. Copy to .env.admin and fill in. Never commit the real file.
PORTAL_MODE=admin
AGENT_URL=http://dc01.corp.example:8080
# The admin key from C:\ProgramData\TempDesk\agent.json ("adminKey").
AGENT_KEY=
# Required: a long random value, for example: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Only for https agent URLs:
# AGENT_CA_FILE=/run/secrets/agent.cer
# AGENT_CERT_SHA256=
# Set to true when the console is served through an HTTPS reverse proxy (adds Secure to cookies).
# COOKIE_SECURE=auto
# TRUSTED_PROXY=
# ADMIN_LOGIN_LIMIT=10
