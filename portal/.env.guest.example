# Guest portal. Copy to .env.guest and fill in. Never commit the real file.
PORTAL_MODE=guest
# The TempDesk Agent on the domain controller. Plain HTTP is the default.
AGENT_URL=http://dc01.corp.example:8080
# The guest key from C:\ProgramData\TempDesk\agent.json ("guestKey").
AGENT_KEY=
# Only for https agent URLs: either the exported certificate (PEM or DER) mounted into the container ...
# AGENT_CA_FILE=/run/secrets/agent.cer
# ... or its SHA-256 fingerprint (colons allowed).
# AGENT_CERT_SHA256=
# Optional: reverse proxy address(es) whose X-Forwarded-For header is trusted (comma separated IPs or CIDRs).
# TRUSTED_PROXY=
# Optional: portal side limit on sign-in creation per client address.
# GUEST_CREATE_LIMIT=10
# GUEST_CREATE_WINDOW_SECONDS=600

# Optional: client-reachable RDP host, optionally followed by a port.
# COMMONS_RDP_TARGET=

# Optional separate destinations for the Virtual Commons edition picker.
# COMMONS_RDP_GUI=
# COMMONS_RDP_CORE=

# Optional dedicated Windows 11 seat. Use a DNS name reachable by the RDP client.
# COMMONS_RDP_KIOSK=kiosk01.corp.example
# COMMONS_KIOSK_BROKER_URL=https://kiosk01.corp.example:9443
# The optional Compose overlays supply the container paths for the credential and CA.
# See README.md for the host-side file checks and guest-only launch command.
# COMMONS_KIOSK_BROKER_KEY_FILE=/run/secrets/commons-kiosk
# COMMONS_KIOSK_BROKER_CA_FILE=/run/secrets/commons-kiosk-ca.pem
