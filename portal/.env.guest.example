# Guest portal. Copy to .env.guest and fill in. Never commit the real file.
PORTAL_MODE=guest
# The TempDesk Agent on the domain controller. Plain HTTP is the default.
AGENT_URL=http://dc01.corp.example:8080
# The guest key from C:\ProgramData\TempDesk\agent.json ("guestKey").
AGENT_KEY=
# Only for https agent URLs: either the exported certificate (PEM or DER) mounted into the container ...
# AGENT_CA_FILE=/run/secrets/agent.cer
# ... or its SHA-256 fingerprint (colons allowed).
# AGENT_CERT_SHA256=
# Optional: reverse proxy address(es) whose X-Forwarded-For header is trusted (comma separated IPs or CIDRs).
# TRUSTED_PROXY=
# Optional: portal side limit on sign-in creation per client address.
# GUEST_CREATE_LIMIT=10
# GUEST_CREATE_WINDOW_SECONDS=600
