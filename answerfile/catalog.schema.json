{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tempdesk/tempdesk/answerfile/catalog.schema.json",
  "title": "TempDesk unattend catalog",
  "description": "Machine-readable, paraphrased catalog of the Microsoft Unattended Windows Setup Reference, used by the TempDesk answer file builders.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "source", "generated", "passes", "components", "unverifiedComponents"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": { "type": "string", "minLength": 1 },
    "sourceUrls": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^https://" } },
    "generated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "passes": {
      "type": "array",
      "const": ["windowsPE", "offlineServicing", "generalize", "specialize", "auditSystem", "auditUser", "oobeSystem"]
    },
    "namespaces": { "type": "object", "additionalProperties": { "type": "string" } },
    "componentAttributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publicKeyToken": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "language": { "type": "string" },
        "versionScope": { "type": "string" }
      }
    },
    "architectures": { "type": "array", "items": { "type": "string" } },
    "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } },
    "unverifiedComponents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "reason"],
        "properties": { "name": { "type": "string" }, "reason": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "pass": { "enum": ["windowsPE", "offlineServicing", "generalize", "specialize", "auditSystem", "auditUser", "oobeSystem"] },
    "passList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/pass" } },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": { "value": { "type": "string" }, "label": { "type": "string" } }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "passes", "deprecated", "settings"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" },
        "summary": { "type": "string", "minLength": 1 },
        "passes": { "$ref": "#/$defs/passList" },
        "appliesTo": { "type": "array", "items": { "enum": ["client", "server"] } },
        "deprecated": { "type": "boolean" },
        "reference": { "enum": ["current", "archive-windows-8.1"], "description": "Which edition of the reference documents the component." },
        "detail": { "enum": ["full", "basic"], "description": "full: every leaf has a type, passes, help and (for enum/boolean) values." },
        "popular": { "type": "boolean", "description": "One of the 40 most used components." },
        "doc": { "type": "string", "description": "Page slug relative to the reference base URL." },
        "settings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/setting" } }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "name", "type", "passes", "help"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*(/[A-Za-z_][A-Za-z0-9_.-]*)*$", "description": "Slash path from the component element, including list item element names." },
        "itemPath": { "type": "string", "description": "Path relative to the nearest enclosing list item; present only inside list items. Model keys inside a list item use this." },
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$" },
        "type": { "enum": ["boolean", "string", "integer", "enum", "password", "list", "container"] },
        "passes": { "$ref": "#/$defs/passList" },
        "values": { "type": "array", "items": { "$ref": "#/$defs/choice" } },
        "suggestions": { "type": "array", "items": { "$ref": "#/$defs/choice" }, "description": "Documented example or special values for a free-form setting." },
        "flags": { "type": "boolean", "description": "Integer made by adding documented flag values (see suggestions)." },
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "maxLength": { "type": "integer", "minimum": 1 },
        "rangeNote": { "type": "string", "description": "Numeric range documented for a value stored as text." },
        "default": { "type": "string" },
        "help": { "type": "string", "minLength": 1 },
        "sensitive": { "type": "boolean" },
        "deprecated": { "type": "boolean" },
        "archivedOnly": { "type": "boolean", "description": "Documented only in the archived Windows 8.1 reference." },
        "encodedPassword": { "type": "boolean", "description": "Container with Value and PlainText children; Value may be encoded." },
        "passwordSuffix": { "enum": ["Password", "AdministratorPassword"] },
        "passesUndocumented": { "type": "boolean" },
        "nameInferred": { "type": "boolean", "description": "Element name recovered from the page source file name because the page title is a display label." },
        "reviewed": { "type": "boolean", "description": "Type or limits hand-checked against the documentation." },
        "doc": { "type": "string" },
        "children": { "type": "array", "items": { "$ref": "#/$defs/setting" } },
        "listItem": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "keyed", "keyStyle", "valueStyle", "settings"],
          "properties": {
            "action": { "const": "add" },
            "keyed": { "type": "boolean" },
            "key": { "type": "string", "description": "Child setting that identifies an item (unique within the list)." },
            "keyStyle": { "enum": ["keyValue", "element"], "description": "keyValue: the Key child is written as the wcm:keyValue attribute; element: the key is an ordinary child element." },
            "valueStyle": { "enum": ["text", "children"], "description": "text: the Value child is written as the item's text content." },
            "settings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/setting" } }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "container" } } }, "then": { "required": ["children"] } },
        { "if": { "properties": { "type": { "const": "list" } } }, "then": { "required": ["listItem"] } },
        { "if": { "properties": { "type": { "const": "enum" } } }, "then": { "required": ["values"] } },
        { "if": { "properties": { "type": { "const": "password" } } }, "then": { "required": ["sensitive"] } }
      ]
    }
  }
}
