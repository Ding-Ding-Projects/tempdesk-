{
 "about": "Hand-written catalogue of every search surface in the TempDesk Deployer. Each one has its own search field with the shared regex builder (vendor/regex-builder.js, copied from site/assets). Checked by test/search-surfaces.test.js.",
 "consumers": {
  "searchBox": "src/renderer/js/ui.js wraps attachRegexBuilder",
  "listFilter": "src/renderer/js/ui.js wraps attachListFilter",
  "attachListFilter": "regex-builder.js list filter",
  "attachTabCloser": "regex-builder.js tab strip search with bulk close",
  "attachRegexBuilder": "regex-builder.js on an existing field"
 },
 "surfaces": [
  {
   "id": "palette",
   "page": "every page",
   "surface": "Command palette (Ctrl+Shift+F)",
   "file": "src/renderer/js/app.js",
   "consumer": "searchBox",
   "match": "searchBox({ label: t('palette.label')"
  },
  {
   "id": "notifications",
   "page": "every page",
   "surface": "Notification centre",
   "file": "src/renderer/js/app.js",
   "consumer": "searchBox",
   "match": "searchBox({ label: t('notif.search')"
  },
  {
   "id": "deployer-tabs",
   "page": "every page",
   "surface": "Open deployment tabs (search, close containing, close not containing)",
   "file": "src/renderer/js/app.js",
   "consumer": "attachTabCloser"
  },
  {
   "id": "deployer-context-menu",
   "page": "every page",
