<#
.SYNOPSIS
    Pure answer file generation for the TempDesk Deployer engine (headless path).

.DESCRIPTION
    Produces the same bytes as the shared JavaScript generator (site/assets/answer.js), which the
    desktop app and the website use for their live editors. This module is what
    Invoke-TempDeskDeploy.ps1 -Phase Media uses, so media can be built without the app.

    Modes:
      server  TempDesk server (Windows Server 2025 Core, fully unattended chain to a ready DC)
      guest   Guest PC (Windows 11, joins the TempDesk domain in specialize)
      custom  General Windows / Windows Server answer file

    Windows unattend password encoding (NOT encryption):
      AdministratorPassword: base64(UTF-16LE(password + "AdministratorPassword"))
      AutoLogon and LocalAccount passwords: base64(UTF-16LE(password + "Password"))

    Media layout (also produced by the website kit):
      autounattend.xml                (root)
      TempDesk\FirstLogon.ps1, Continue-Setup.ps1, SetupStatus.ps1, firstboot.json
      TempDesk\server\, agent\, client\, and portal\ when portals.mode = native
#>
Set-StrictMode -Version 3

$script:NS = 'urn:schemas-microsoft-com:unattend'
$script:WCM = 'http://schemas.microsoft.com/WMIConfig/2002/State'
$script:PassOrder = @('windowsPE', 'offlineServicing', 'generalize', 'specialize', 'auditSystem', 'auditUser', 'oobeSystem')
$script:FirstLogonCmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command `"`$f = Get-PSDrive -PSProvider FileSystem | ForEach-Object { Join-Path `$_.Root 'TempDesk\FirstLogon.ps1' } | Where-Object { Test-Path `$_ } | Select-Object -First 1; if (`$f) { & `$f }`""
$script:EdgeCmd = 'reg.exe add "HKLM\SOFTWARE\Policies\Microsoft\Edge" /v HideFirstRunExperience /t REG_DWORD /d 1 /f'
$script:ServerComment = 'Generated by TempDesk. Contains the Administrator password in Windows unattend encoding (base64, not encryption). Erase the media after installing.'
$script:GuestComment = 'Generated by TempDesk. WARNING: the domain join password is stored in PLAIN TEXT in this file. Use a dedicated account that can only join computers, and erase the media after installing.'
$script:CustomComment = 'Generated by the TempDesk answer file builder. Passwords use Windows unattend encoding (base64, not encryption). Erase the media after installing.'
$script:OobeHide = @('HideEULAPage', 'HideOEMRegistrationScreen', 'HideOnlineAccountScreens', 'HideWirelessSetupInOOBE', 'HideLocalAccountScreen')

# ------------------------------------------------------------------------------------------
# Password encoding
# ------------------------------------------------------------------------------------------
function ConvertTo-UnattendPassword {
    <# base64(UTF-16LE(Password + Suffix)). Suffix is AdministratorPassword or Password. #>
    param([Parameter(Mandatory)][AllowEmptyString()][string] $Password, [Parameter(Mandatory)][ValidateSet('AdministratorPassword', 'Password')][string] $Suffix)
    [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($Password + $Suffix))
}

function ConvertFrom-UnattendPassword {
    <# Reverse of ConvertTo-UnattendPassword. Returns $null when the value is not in that encoding. #>
    param([Parameter(Mandatory)][AllowEmptyString()][string] $Value, [Parameter(Mandatory)][string] $Suffix)
    try {
        $bytes = [Convert]::FromBase64String($Value.Trim())
        if ($bytes.Length % 2) { return $null }
        $s = [Text.Encoding]::Unicode.GetString($bytes)
        if ($s.EndsWith($Suffix, [StringComparison]::Ordinal)) { return $s.Substring(0, $s.Length - $Suffix.Length) }
        return $null
    } catch { return $null }
}

# ------------------------------------------------------------------------------------------
# Element tree: @{ n = name; a = [ordered]@{}; c = List; t = '' }
# ------------------------------------------------------------------------------------------
function script:El {
    param([string] $Name, $Attrs = $null, $Children = $null)
    $e = @{ n = $Name; a = [ordered]@{}; c = (New-Object System.Collections.ArrayList); t = '' }
    if ($Attrs) { foreach ($k in $Attrs.Keys) { if ($null -ne $Attrs[$k]) { $e.a[$k] = [string]$Attrs[$k] } } }
    if ($Children -is [string] -or $Children -is [int] -or $Children -is [long]) { $e.t = [string]$Children }
    elseif ($null -ne $Children) { foreach ($ch in @($Children)) { if ($ch) { [void]$e.c.Add($ch) } } }
    $e
}
function script:Leaf { param([string] $Name, $Text) $t = if ($null -eq $Text) { '' } else { [string]$Text }; $e = El $Name; $e.t = $t; $e }
function script:AddItem {
    param([string] $Name, $Children, $KeyValue = $null)
    $a = [ordered]@{ 'wcm:action' = 'add' }
    if ($null -ne $KeyValue) { $a['wcm:keyValue'] = [string]$KeyValue }
    El $Name $a $Children
}
function script:Component {
    param([string] $Name, [string] $Arch, $Children)
    if (-not $Arch) { $Arch = 'amd64' }
    El 'component' ([ordered]@{ name = $Name; processorArchitecture = $Arch; publicKeyToken = '31bf3856ad364e35'; language = 'neutral'; versionScope = 'nonSxS' }) $Children
}
function script:NewDoc { El 'unattend' ([ordered]@{ xmlns = $script:NS; 'xmlns:wcm' = $script:WCM }) @() }
function script:GetSettings {
    param($Doc, [string] $Pass)
    foreach ($s in $Doc.c) { if ($s.n -eq 'settings' -and $s.a['pass'] -eq $Pass) { return $s } }
    $s = El 'settings' ([ordered]@{ pass = $Pass }) @()
    $idx = $script:PassOrder.IndexOf($Pass); $at = $Doc.c.Count
    for ($j = 0; $j -lt $Doc.c.Count; $j++) {
        if ($Doc.c[$j].n -eq 'settings' -and $script:PassOrder.IndexOf($Doc.c[$j].a['pass']) -gt $idx) { $at = $j; break }
    }
    $Doc.c.Insert($at, $s)
    $s
}
function script:IntOr { param($Value, [int] $Default) $n = 0; if ([int]::TryParse(([string]$Value).Trim(), [ref]$n) -and $n -ne 0) { $n } else { $Default } }
function script:ParseIntJs {
    <# JavaScript parseInt(v, 10) for the leading integer; $null when NaN. #>
    param($Value)
    $m = [regex]::Match([string]$Value, '^\s*([+-]?\d+)')
    if ($m.Success) { [long]$m.Groups[1].Value } else { $null }
}
function script:Truthy { param($v) return ($v -eq $true -or $v -eq 'true' -or $v -eq 1 -or $v -eq '1' -or $v -eq 'on') }
function script:Str { param($v) if ($null -eq $v) { '' } else { [string]$v } }
function script:Get { param($o, [string] $k) if ($o -is [System.Collections.IDictionary]) { if ($o.Contains($k)) { $o[$k] } else { $null } } elseif ($o -and $o.PSObject.Properties[$k]) { $o.$k } else { $null } }

function ConvertTo-XmlText { param([AllowEmptyString()][string] $s) $s.Replace('&', '&amp;').Replace('<', '&lt;').Replace('>', '&gt;').Replace('"', '&quot;') }

function ConvertTo-UnattendXmlText {
    <# Serializes an element tree like the JS serializer: 2-space indent, CRLF, trailing CRLF. #>
    param([Parameter(Mandatory)] $Doc, [string] $Comment = '', [string] $Newline = "`r`n")
    $out = New-Object System.Collections.Generic.List[string]
    $out.Add('<?xml version="1.0" encoding="utf-8"?>')
    if ($Comment) { $out.Add('<!-- ' + $Comment.Replace('--', '- -') + ' -->') }
    $write = $null
    $write = {
        param($e, [int] $depth)
        $pad = '  ' * $depth
        $attrs = ''
        foreach ($k in $e.a.Keys) { $attrs += ' ' + $k + '="' + (ConvertTo-XmlText $e.a[$k]) + '"' }
        if ($e.c.Count) {
            $out.Add($pad + '<' + $e.n + $attrs + '>')
            foreach ($ch in $e.c) { & $write $ch ($depth + 1) }
            $out.Add($pad + '</' + $e.n + '>')
        } elseif ($e.t -ne '') {
            $out.Add($pad + '<' + $e.n + $attrs + '>' + (ConvertTo-XmlText $e.t) + '</' + $e.n + '>')
        } else {
            $out.Add($pad + '<' + $e.n + $attrs + ' />')
        }
    }
    & $write $Doc 0
    ($out -join $Newline) + $Newline
}

# ------------------------------------------------------------------------------------------
# Building blocks
# ------------------------------------------------------------------------------------------
function script:IntlPE { param($Arch, $SetupLang, $f)
    $ui = if ($f.locale) { $f.locale } else { 'en-US' }
    $kb = if ($f.keyboard) { $f.keyboard } else { $ui }
    $sl = if ($SetupLang) { $SetupLang } else { $ui }
    Component 'Microsoft-Windows-International-Core-WinPE' $Arch @(
        (El 'SetupUILanguage' $null @((Leaf 'UILanguage' $sl))),
        (Leaf 'InputLocale' $kb), (Leaf 'SystemLocale' $ui), (Leaf 'UILanguage' $ui), (Leaf 'UserLocale' $ui))
}
function script:IntlOobe { param($Arch, $f)
    $ui = if ($f.locale) { $f.locale } else { 'en-US' }
    $kb = if ($f.keyboard) { $f.keyboard } else { $ui }
    Component 'Microsoft-Windows-International-Core' $Arch @((Leaf 'InputLocale' $kb), (Leaf 'SystemLocale' $ui), (Leaf 'UILanguage' $ui), (Leaf 'UserLocale' $ui))
}
function script:DiskConfig { param($DiskId, [string] $Firmware)
    $id = [string](IntOr $DiskId 0)
    if ($Firmware -eq 'bios') {
        $cp = @(
            (AddItem 'CreatePartition' @((Leaf 'Order' 1), (Leaf 'Type' 'Primary'), (Leaf 'Size' 500))),
            (AddItem 'CreatePartition' @((Leaf 'Order' 2), (Leaf 'Type' 'Primary'), (Leaf 'Extend' 'true'))))
        $mp = @(
            (AddItem 'ModifyPartition' @((Leaf 'Order' 1), (Leaf 'PartitionID' 1), (Leaf 'Format' 'NTFS'), (Leaf 'Label' 'System'), (Leaf 'Active' 'true'))),
            (AddItem 'ModifyPartition' @((Leaf 'Order' 2), (Leaf 'PartitionID' 2), (Leaf 'Format' 'NTFS'), (Leaf 'Label' 'Windows'), (Leaf 'Letter' 'C'))))
    } else {
        $cp = @(
            (AddItem 'CreatePartition' @((Leaf 'Order' 1), (Leaf 'Type' 'EFI'), (Leaf 'Size' 300))),
            (AddItem 'CreatePartition' @((Leaf 'Order' 2), (Leaf 'Type' 'MSR'), (Leaf 'Size' 16))),
            (AddItem 'CreatePartition' @((Leaf 'Order' 3), (Leaf 'Type' 'Primary'), (Leaf 'Extend' 'true'))))
        $mp = @(
            (AddItem 'ModifyPartition' @((Leaf 'Order' 1), (Leaf 'PartitionID' 1), (Leaf 'Format' 'FAT32'), (Leaf 'Label' 'System'))),
            (AddItem 'ModifyPartition' @((Leaf 'Order' 2), (Leaf 'PartitionID' 2))),
            (AddItem 'ModifyPartition' @((Leaf 'Order' 3), (Leaf 'PartitionID' 3), (Leaf 'Format' 'NTFS'), (Leaf 'Label' 'Windows'), (Leaf 'Letter' 'C'))))
    }
    El 'DiskConfiguration' $null @((AddItem 'Disk' @((Leaf 'DiskID' $id), (Leaf 'WillWipeDisk' 'true'), (El 'CreatePartitions' $null $cp), (El 'ModifyPartitions' $null $mp))))
}
function script:InstallPartitionFor { param([string] $Firmware) if ($Firmware -eq 'bios') { 2 } else { 3 } }
function script:ImageInstall { param($DiskId, $PartitionId, [bool] $ByName, $Image)
    $meta = if ($ByName) { AddItem 'MetaData' @((Leaf 'Key' '/IMAGE/NAME'), (Leaf 'Value' $Image)) } else { AddItem 'MetaData' @((Leaf 'Key' '/IMAGE/INDEX'), (Leaf 'Value' (IntOr $Image 1))) }
    El 'ImageInstall' $null @((El 'OSImage' $null @(
        (El 'InstallFrom' $null @($meta)),
        (El 'InstallTo' $null @((Leaf 'DiskID' (IntOr $DiskId 0)), (Leaf 'PartitionID' (IntOr $PartitionId 1)))))))
}
function script:UserData { param($ProductKey, $Org, $Owner)
    $kids = @((Leaf 'AcceptEula' 'true'))
    if ($ProductKey) { $kids += (El 'ProductKey' $null @((Leaf 'Key' $ProductKey), (Leaf 'WillShowUI' 'OnError'))) }
    if ($Org) { $kids += (Leaf 'Organization' $Org) }
    if ($Owner) { $kids += (Leaf 'FullName' $Owner) }
    El 'UserData' $null $kids
}
function script:Pw { param([string] $Name, $Value)
    $suffix = if ($Name -eq 'AdministratorPassword') { 'AdministratorPassword' } else { 'Password' }
    El $Name $null @((Leaf 'Value' (ConvertTo-UnattendPassword -Password (Str $Value) -Suffix $suffix)), (Leaf 'PlainText' 'false'))
}
function script:SyncCommands { param([string] $ListName, [string] $ItemName, [string] $CmdName, $Items, [bool] $RequiresUserInput)
    $i = 0
    $list = foreach ($it in @($Items)) {
        $i++
        $kids = @((Leaf 'Order' $i))
        if ($it.description) { $kids += (Leaf 'Description' $it.description) }
        $kids += (Leaf $CmdName $it.command)
        if ($RequiresUserInput) { $kids += (Leaf 'RequiresUserInput' 'false') }
        AddItem $ItemName $kids
    }
    El $ListName $null @($list)
}
function script:SplitList { param($v)
    if ($v -is [array]) { return @($v | ForEach-Object { [string]$_ } | Where-Object { $_ }) }
    @((Str $v) -split '[\s,;]+' | Where-Object { $_ })
}
function script:Lines { param($v) @((Str $v) -split '\r?\n' | ForEach-Object { $_.Trim() } | Where-Object { $_ }) }

function Get-TdDomainDn { param([string] $Domain) (@($Domain -split '\.' | Where-Object { $_ } | ForEach-Object { 'DC=' + $_ })) -join ',' }
function Get-TdSuggestedNetbios { param([string] $Domain) $first = ($Domain -split '\.')[0]; $x = ($first -replace '[^A-Za-z0-9-]', ''); if ($x.Length -gt 15) { $x = $x.Substring(0, 15) }; $x.ToUpperInvariant() }
function Get-TdGuestDnsCommand { param($Dns)
    $list = (@(SplitList $Dns | ForEach-Object { "'" + $_ + "'" })) -join ','
    "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command `"Get-NetAdapter -Physical | Sort-Object ifIndex | Select-Object -First 1 | Set-DnsClientServerAddress -ServerAddresses " + $list + '"'
}

# ------------------------------------------------------------------------------------------
# Mode trees
# ------------------------------------------------------------------------------------------
function script:ServerTree { param($o)
    $arch = 'amd64'; $doc = NewDoc
    $loc = if ((Get $o 'locale')) { Get $o 'locale' } else { 'en-US' }
    $kb = if ((Get $o 'keyboard')) { Get $o 'keyboard' } elseif ((Get $o 'locale')) { Get $o 'locale' } else { 'en-US' }
    $f = @{ locale = $loc; keyboard = $kb }
    $fw = Str (Get $o 'firmware')
    $pe = GetSettings $doc 'windowsPE'
    [void]$pe.c.Add((IntlPE $arch $null $f))
    [void]$pe.c.Add((Component 'Microsoft-Windows-Setup' $arch @((DiskConfig 0 $fw), (ImageInstall 0 (InstallPartitionFor $fw) $false (Get $o 'imageIndex')), (UserData (Get $o 'productKey') $null $null))))
    $tz = if ((Get $o 'timeZone')) { Get $o 'timeZone' } else { 'Eastern Standard Time' }
    [void](GetSettings $doc 'specialize').c.Add((Component 'Microsoft-Windows-Shell-Setup' $arch @((Leaf 'ComputerName' (Get $o 'computerName')), (Leaf 'TimeZone' $tz))))
    $ap = Str (Get $o 'adminPassword')
    $oobe = GetSettings $doc 'oobeSystem'
    [void]$oobe.c.Add((IntlOobe $arch $f))
    [void]$oobe.c.Add((Component 'Microsoft-Windows-Shell-Setup' $arch @(
        (El 'UserAccounts' $null @((Pw 'AdministratorPassword' $ap))),
        (El 'AutoLogon' $null @((Pw 'Password' $ap), (Leaf 'Enabled' 'true'), (Leaf 'LogonCount' 1), (Leaf 'Username' 'Administrator'))),
        (El 'OOBE' $null @((Leaf 'HideEULAPage' 'true'), (Leaf 'HideLocalAccountScreen' 'true'), (Leaf 'HideOnlineAccountScreens' 'true'), (Leaf 'HideWirelessSetupInOOBE' 'true'), (Leaf 'ProtectYourPC' 3))),
        (SyncCommands 'FirstLogonCommands' 'SynchronousCommand' 'CommandLine' @(@{ command = $script:FirstLogonCmd; description = 'TempDesk unattended setup' }) $true))))
    $doc
}

function script:GuestTree { param($o)
    $arch = if ((Get $o 'arch')) { Get $o 'arch' } else { 'amd64' }
    $doc = NewDoc
    $loc = if ((Get $o 'locale')) { Get $o 'locale' } else { 'en-US' }
    $kb = if ((Get $o 'keyboard')) { Get $o 'keyboard' } elseif ((Get $o 'locale')) { Get $o 'locale' } else { 'en-US' }
    $f = @{ locale = $loc; keyboard = $kb }
    $fw = Str (Get $o 'firmware')
    $pe = GetSettings $doc 'windowsPE'
    [void]$pe.c.Add((IntlPE $arch $null $f))
    [void]$pe.c.Add((Component 'Microsoft-Windows-Setup' $arch @((DiskConfig (Get $o 'diskId') $fw), (ImageInstall (Get $o 'diskId') (InstallPartitionFor $fw) $false (Get $o 'imageIndex')), (UserData (Get $o 'productKey') $null $null))))
    $spec = GetSettings $doc 'specialize'
    $cn = if ((Get $o 'computerName')) { Get $o 'computerName' } else { '*' }
    $tz = if ((Get $o 'timeZone')) { Get $o 'timeZone' } else { 'Eastern Standard Time' }
    [void]$spec.c.Add((Component 'Microsoft-Windows-Shell-Setup' $arch @((Leaf 'ComputerName' $cn), (Leaf 'TimeZone' $tz))))
    if ((Get $o 'dnsMode') -ne 'dhcp' -and @(SplitList (Get $o 'dnsServer')).Count) {
        [void]$spec.c.Add((Component 'Microsoft-Windows-Deployment' $arch @((SyncCommands 'RunSynchronous' 'RunSynchronousCommand' 'Path' @(@{ command = (Get-TdGuestDnsCommand (Get $o 'dnsServer')); description = 'Point DNS at the TempDesk domain controller before the domain join' }) $false))))
    }
    $domain = Str (Get $o 'domainName')
    $jd = if ((Get $o 'joinDomain')) { Get $o 'joinDomain' } else { $domain }
    $ou = if ((Get $o 'ou')) { Get $o 'ou' } else { 'OU=Computers,OU=TempDesk,' + (Get-TdDomainDn $domain) }
    [void]$spec.c.Add((Component 'Microsoft-Windows-UnattendedJoin' $arch @((El 'Identification' $null @(
        (El 'Credentials' $null @((Leaf 'Domain' $jd), (Leaf 'Password' (Str (Get $o 'joinPassword'))), (Leaf 'Username' (Str (Get $o 'joinUser'))))),
        (Leaf 'JoinDomain' $domain), (Leaf 'MachineObjectOU' $ou))))))
    $oobeKids = @((El 'OOBE' $null @((Leaf 'HideEULAPage' 'true'), (Leaf 'HideOEMRegistrationScreen' 'true'), (Leaf 'HideOnlineAccountScreens' 'true'), (Leaf 'HideWirelessSetupInOOBE' 'true'), (Leaf 'HideLocalAccountScreen' 'true'), (Leaf 'ProtectYourPC' 3))))
    $au = Get $o 'adminUser'
    if ($au) {
        $oobeKids = @((El 'UserAccounts' $null @((El 'LocalAccounts' $null @((AddItem 'LocalAccount' @(
            (Pw 'Password' (Str (Get $o 'adminPassword'))), (Leaf 'Description' 'Local administrator (TempDesk guest PC)'),
            (Leaf 'DisplayName' $au), (Leaf 'Group' 'Administrators'), (Leaf 'Name' $au)))))))) + $oobeKids
    }
    $oobe = GetSettings $doc 'oobeSystem'
    [void]$oobe.c.Add((IntlOobe $arch $f))
    [void]$oobe.c.Add((Component 'Microsoft-Windows-Shell-Setup' $arch $oobeKids))
    $doc
}

function script:FeatureCommand { param($o)
    $names = @(SplitList (Get $o 'features'))
    if (-not $names.Count) { return $null }
    if ((Get $o 'target') -eq 'server') {
        return @{ command = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Install-WindowsFeature -Name ' + ($names -join ',') + ' -IncludeManagementTools"'; description = 'Enable Windows features (TempDesk builder)' }
    }
    @{ command = 'cmd.exe /c ' + ((@($names | ForEach-Object { 'dism.exe /online /enable-feature /featurename:' + $_ + ' /all /norestart' })) -join ' & '); description = 'Enable Windows features (TempDesk builder)' }
}

function script:CustomTree { param($o)
    $arch = if ((Get $o 'arch')) { Get $o 'arch' } else { 'amd64' }
    $doc = NewDoc
    $loc = if ((Get $o 'locale')) { Get $o 'locale' } else { 'en-US' }
    $kb = if ((Get $o 'keyboard')) { Get $o 'keyboard' } elseif ((Get $o 'locale')) { Get $o 'locale' } else { 'en-US' }
    $f = @{ locale = $loc; keyboard = $kb }
    $setupKids = @()
    $layout = if ((Get $o 'diskLayout')) { Get $o 'diskLayout' } else { 'uefi' }
    if ($layout -eq 'existing') { $part = IntOr (Get $o 'partitionId') 1 }
    else {
        $fw = if ($layout -eq 'bios') { 'bios' } else { 'uefi' }
        $setupKids += (DiskConfig (Get $o 'diskId') $fw); $part = InstallPartitionFor $fw
    }
    $byName = (Get $o 'imageBy') -eq 'name'
    $img = if ($byName) { Get $o 'imageName' } else { Get $o 'imageIndex' }
    $setupKids += (ImageInstall (Get $o 'diskId') $part $byName $img)
    $setupKids += (UserData (Get $o 'productKey') (Get $o 'organization') (Get $o 'owner'))
    $pe = GetSettings $doc 'windowsPE'
    [void]$pe.c.Add((IntlPE $arch (Get $o 'setupLanguage') $f))
    [void]$pe.c.Add((Component 'Microsoft-Windows-Setup' $arch $setupKids))
    $drivers = @(Lines (Get $o 'driversPE'))
    if ($drivers.Count) {
        $i = 0
        [void]$pe.c.Add((Component 'Microsoft-Windows-PnpCustomizationsWinPE' $arch @((El 'DriverPaths' $null @($drivers | ForEach-Object { $i++; AddItem 'PathAndCredentials' @((Leaf 'Path' $_)) ([string]$i) })))))
    }
    $off = @(Lines (Get $o 'driversOffline'))
    if ($off.Count) {
        $i = 0
        [void](GetSettings $doc 'offlineServicing').c.Add((Component 'Microsoft-Windows-PnpCustomizationsNonWinPE' $arch @((El 'DriverPaths' $null @($off | ForEach-Object { $i++; AddItem 'PathAndCredentials' @((Leaf 'Path' $_)) ([string]$i) })))))
    }
    $spec = GetSettings $doc 'specialize'
    $cn = if ((Get $o 'computerName')) { Get $o 'computerName' } else { '*' }
    $shell = @((Leaf 'ComputerName' $cn))
    if ((Get $o 'organization')) { $shell += (Leaf 'RegisteredOrganization' (Get $o 'organization')) }
    if ((Get $o 'owner')) { $shell += (Leaf 'RegisteredOwner' (Get $o 'owner')) }
    $tz = if ((Get $o 'timeZone')) { Get $o 'timeZone' } else { 'Eastern Standard Time' }
    $shell += (Leaf 'TimeZone' $tz)
    [void]$spec.c.Add((Component 'Microsoft-Windows-Shell-Setup' $arch $shell))
    $runSync = @()
    if (Truthy (Get $o 'edgeFirstRunOff')) { $runSync += @{ command = $script:EdgeCmd; description = 'Edge first-run experience off (policy)' } }
    if ($runSync.Count) { [void]$spec.c.Add((Component 'Microsoft-Windows-Deployment' $arch @((SyncCommands 'RunSynchronous' 'RunSynchronousCommand' 'Path' $runSync $false)))) }
    if (Truthy (Get $o 'rdp')) {
        [void]$spec.c.Add((Component 'Microsoft-Windows-TerminalServices-LocalSessionManager' $arch @((Leaf 'fDenyTSConnections' 'false'))))
        [void]$spec.c.Add((Component 'Networking-MPSSVC-Svc' $arch @((El 'FirewallGroups' $null @((AddItem 'FirewallGroup' @((Leaf 'Active' 'true'), (Leaf 'Group' 'Remote Desktop'), (Leaf 'Profile' 'all')) 'RemoteDesktop'))))))
        [void]$spec.c.Add((Component 'Microsoft-Windows-TerminalServices-RDP-WinStationExtensions' $arch @((Leaf 'UserAuthentication' 1))))
    }
    $oobe = @()
    $accounts = @(@(Get $o 'accounts') | Where-Object { $_ -and (Str (Get $_ 'name')).Trim() })
    $ua = @()
    if ((Get $o 'adminPassword')) { $ua += (Pw 'AdministratorPassword' (Get $o 'adminPassword')) }
    if ($accounts.Count) {
        $ua += (El 'LocalAccounts' $null @($accounts | ForEach-Object {
            $dn = if ((Get $_ 'displayName')) { Get $_ 'displayName' } else { Get $_ 'name' }
            $grp = if ((Get $_ 'group') -eq 'Users') { 'Users' } else { 'Administrators' }
            AddItem 'LocalAccount' @((Pw 'Password' (Str (Get $_ 'password'))), (Leaf 'DisplayName' $dn), (Leaf 'Group' $grp), (Leaf 'Name' (Get $_ 'name')))
        }))
    }
    if ($ua.Count) { $oobe += (El 'UserAccounts' $null $ua) }
    $alc = IntOr (Get $o 'autoLogonCount') 0
    if ($alc -gt 0) {
        if ($accounts.Count) { $whoName = Get $accounts[0] 'name'; $whoPw = Str (Get $accounts[0] 'password') } else { $whoName = 'Administrator'; $whoPw = Str (Get $o 'adminPassword') }
        $oobe += (El 'AutoLogon' $null @((Pw 'Password' $whoPw), (Leaf 'Enabled' 'true'), (Leaf 'LogonCount' $alc), (Leaf 'Username' $whoName)))
    }
    $hide = @($script:OobeHide | Where-Object { Truthy (Get $o ('oobe' + $_)) } | ForEach-Object { Leaf $_ 'true' })
    if ((Get $o 'protectYourPC')) { $hide += (Leaf 'ProtectYourPC' (IntOr (Get $o 'protectYourPC') 3)) }
    if ($hide.Count) { $oobe += (El 'OOBE' $null $hide) }
    $fl = @()
    $feat = FeatureCommand $o
    if ($feat) { $fl += $feat }
    if ($fl.Count) { $oobe += (SyncCommands 'FirstLogonCommands' 'SynchronousCommand' 'CommandLine' $fl $true) }
    $os = GetSettings $doc 'oobeSystem'
    [void]$os.c.Add((IntlOobe $arch $f))
    if ($oobe.Count) { [void]$os.c.Add((Component 'Microsoft-Windows-Shell-Setup' $arch $oobe)) }
    $doc
}

$script:CommandLists = [ordered]@{
    runSync    = @{ pass = 'specialize'; component = 'Microsoft-Windows-Deployment'; list = 'RunSynchronous'; item = 'RunSynchronousCommand'; cmd = 'Path'; reboot = $true; creds = $true; userInput = $false }
    runAsync   = @{ pass = 'specialize'; component = 'Microsoft-Windows-Deployment'; list = 'RunAsynchronous'; item = 'RunAsynchronousCommand'; cmd = 'Path'; reboot = $false; creds = $true; userInput = $false }
    firstLogon = @{ pass = 'oobeSystem'; component = 'Microsoft-Windows-Shell-Setup'; list = 'FirstLogonCommands'; item = 'SynchronousCommand'; cmd = 'CommandLine'; reboot = $false; creds = $false; userInput = $true }
    logon      = @{ pass = 'oobeSystem'; component = 'Microsoft-Windows-Shell-Setup'; list = 'LogonCommands'; item = 'AsynchronousCommand'; cmd = 'CommandLine'; reboot = $false; creds = $false; userInput = $true }
}
function script:GetComponentIn { param($Doc, [string] $Pass, [string] $Name, [string] $Arch)
    $s = GetSettings $Doc $Pass
    foreach ($c in $s.c) { if ($c.n -eq 'component' -and $c.a['name'] -eq $Name) { return $c } }
    $c = Component $Name $Arch @(); [void]$s.c.Add($c); $c
}
function script:MergeCommands { param($Doc, $Commands, [string] $Arch)
    if (-not $Commands) { return }
    foreach ($k in $script:CommandLists.Keys) {
        $items = @(@(Get $Commands $k) | Where-Object { $_ -and -not (Truthy (Get $_ 'disabled')) -and (Str (Get $_ 'command')).Trim() })
        if (-not $items.Count) { continue }
        $def = $script:CommandLists[$k]
        $comp = GetComponentIn $Doc $def.pass $def.component $Arch
        $list = $null
        foreach ($c in $comp.c) { if ($c.n -eq $def.list) { $list = $c; break } }
        if (-not $list) { $list = El $def.list $null @(); [void]$comp.c.Add($list) }
        $used = @($list.c | Where-Object { $_.n -eq $def.item } | ForEach-Object { $o = $_.c | Where-Object { $_.n -eq 'Order' } | Select-Object -First 1; if ($o) { IntOr $o.t 0 } else { 0 } })
        $next = if ($used.Count) { ($used | Measure-Object -Maximum).Maximum + 1 } else { 1 }
        foreach ($it in $items) {
            $kids = @((Leaf 'Order' $next))
            if ((Get $it 'description')) { $kids += (Leaf 'Description' (Get $it 'description')) }
            $kids += (Leaf $def.cmd (Get $it 'command'))
            $wr = Get $it 'willReboot'
            if ($def.reboot -and $wr -and $wr -ne 'Never') { $kids += (Leaf 'WillReboot' $wr) }
            if ($def.userInput) { $kids += (Leaf 'RequiresUserInput' 'false') }
            $cr = Get $it 'credentials'
            if ($def.creds -and $cr -and ((Get $cr 'username') -or (Get $cr 'domain'))) {
                $kids += (El 'Credentials' $null @((Leaf 'Domain' (Str (Get $cr 'domain'))), (Leaf 'Password' (Str (Get $cr 'password'))), (Leaf 'Username' (Str (Get $cr 'username')))))
            }
            [void]$list.c.Add((AddItem $def.item $kids))
            $next++
        }
    }
}

function New-TdAnswerFileXml {
    <#
    .SYNOPSIS
        Returns autounattend.xml text for one mode. Form is a hashtable or object with the same
        field names as the shared JavaScript model (for example computerName, adminPassword).
    #>
    param([Parameter(Mandatory)][ValidateSet('server', 'guest', 'custom')][string] $Mode, [Parameter(Mandatory)] $Form, $Commands = $null)
    switch ($Mode) {
        'server' { $doc = ServerTree $Form; $c = $script:ServerComment; $arch = 'amd64' }
        'guest' { $doc = GuestTree $Form; $c = $script:GuestComment; $arch = if ((Get $Form 'arch')) { Get $Form 'arch' } else { 'amd64' } }
        'custom' { $doc = CustomTree $Form; $c = $script:CustomComment; $arch = if ((Get $Form 'arch')) { Get $Form 'arch' } else { 'amd64' } }
    }
    MergeCommands $doc $Commands $arch
    ConvertTo-UnattendXmlText -Doc $doc -Comment $c
}

function New-TdFirstbootJson {
    <# firstboot.json for the TempDesk server media, byte-compatible with JSON.stringify(..., null, 2) + "\n". #>
    param([Parameter(Mandatory)] $Form)
    $pl = ParseIntJs (Get $Form 'prefixLength')
    $nb = (Str (Get $Form 'netbiosName')).ToUpperInvariant()
    $fl = if ((Get $Form 'functionalLevel')) { Get $Form 'functionalLevel' } else { '' }
    $iau = if ((Get $Form 'initialAdminUser')) { Get $Form 'initialAdminUser' } else { 'Administrator' }
    $mode = if ((Get $Form 'portalsMode') -eq 'native') { 'native' } else { 'none' }
    $o = [ordered]@{
        computerName = (Get $Form 'computerName'); ipAddress = (Get $Form 'ipAddress'); prefixLength = $pl; gateway = (Get $Form 'gateway')
        dnsServers = @(SplitList (Get $Form 'dnsServers')); domainName = (Get $Form 'domainName'); netbiosName = $nb; functionalLevel = $fl
        dsrmPassword = (Get $Form 'dsrmPassword'); initialAdminUser = $iau
        agent = [ordered]@{ tls = [bool](Truthy (Get $Form 'agentTls')) }; portals = [ordered]@{ mode = $mode }
    }
    # JSON.stringify drops undefined properties; keep parity by dropping $null strings.
    foreach ($k in @('computerName', 'ipAddress', 'gateway', 'domainName', 'dsrmPassword')) { if ($null -eq $o[$k]) { $o.Remove($k) } }
    (ConvertTo-TdJson $o 2) + "`n"
}

# ------------------------------------------------------------------------------------------
# Validation (same rules and messages as the shared generator's server mode)
# ------------------------------------------------------------------------------------------
function Test-TdStrongPassword { param([AllowEmptyString()][string] $Password)
    $Password.Length -ge 12 -and $Password -cmatch '[a-z]' -and $Password -cmatch '[A-Z]' -and $Password -match '\d' -and $Password -match '[^A-Za-z0-9]'
}

function Test-TdServerForm {
    <# Returns a hashtable field -> message. Empty means valid. #>
    param([Parameter(Mandatory)] $Form)
    $e = [ordered]@{}
    $ip = '^(25[0-5]|2[0-4]\d|1?\d?\d)(\.(25[0-5]|2[0-4]\d|1?\d?\d)){3}$'
    $cn = Str (Get $Form 'computerName')
    if ($cn -notmatch '^[A-Za-z0-9-]{1,15}$' -or $cn -match '^\d+$') { $e.computerName = 'Use 1 to 15 letters, numbers or hyphens (not only numbers).' }
    if ((Str (Get $Form 'domainName')) -notmatch '^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$') { $e.domainName = 'Use a full DNS name such as lab.example.org.' }
    if ((Str (Get $Form 'netbiosName')) -notmatch '^[A-Za-z0-9-]{1,15}$') { $e.netbiosName = 'Use 1 to 15 letters, numbers or hyphens.' }
    if ((Str (Get $Form 'ipAddress')) -notmatch $ip) { $e.ipAddress = 'Enter an IPv4 address.' }
    if ((Str (Get $Form 'gateway')) -notmatch $ip) { $e.gateway = 'Enter an IPv4 address.' }
    $p = ParseIntJs (Get $Form 'prefixLength')
    if ($null -eq $p -or $p -lt 8 -or $p -gt 30) { $e.prefixLength = 'Use a prefix between 8 and 30 (24 is common).' }
    $dns = @(SplitList (Get $Form 'dnsServers'))
    if (-not $dns.Count -or @($dns | Where-Object { $_ -notmatch $ip }).Count) { $e.dnsServers = 'Enter one or more IPv4 addresses, separated by commas.' }
    if (-not (Test-TdStrongPassword (Str (Get $Form 'adminPassword')))) { $e.adminPassword = 'At least 12 characters with upper and lower case, a number and a symbol.' }
    if (-not (Test-TdStrongPassword (Str (Get $Form 'dsrmPassword')))) { $e.dsrmPassword = 'At least 12 characters with upper and lower case, a number and a symbol.' }
    $pk = Str (Get $Form 'productKey')
    if ($pk -and $pk -notmatch '^([A-Z0-9]{5}-){4}[A-Z0-9]{5}$') { $e.productKey = 'Format: XXXXX-XXXXX-XXXXX-XXXXX-XXXXX, or leave empty.' }
    $e
}

# ------------------------------------------------------------------------------------------
# Media folder, zip kit and ISO
# ------------------------------------------------------------------------------------------
function New-TdMediaFolder {
    <#
    .SYNOPSIS
        Writes autounattend.xml and the TempDesk\ folder (scripts, firstboot.json, payload) into
        OutDir. PayloadRoot is the folder holding server\, agent\, client\, portal\.
    #>
    param(
        [Parameter(Mandatory)][string] $OutDir,
        [Parameter(Mandatory)] $Form,
        [Parameter(Mandatory)][string] $PayloadRoot
    )
    $td = Join-Path $OutDir 'TempDesk'
    if (Test-Path -LiteralPath $OutDir) { Remove-Item -LiteralPath $OutDir -Recurse -Force }
    New-Item -ItemType Directory -Force -Path $td | Out-Null
    $utf8 = New-Object System.Text.UTF8Encoding($false)
    [IO.File]::WriteAllText((Join-Path $OutDir 'autounattend.xml'), (New-TdAnswerFileXml -Mode server -Form $Form), $utf8)
    [IO.File]::WriteAllText((Join-Path $td 'firstboot.json'), (New-TdFirstbootJson -Form $Form), $utf8)
    $fb = Join-Path (Join-Path $PayloadRoot 'server') 'firstboot'
    foreach ($s in @('FirstLogon.ps1', 'Continue-Setup.ps1', 'SetupStatus.ps1')) {
        $src = Join-Path $fb $s
        if (-not (Test-Path -LiteralPath $src)) { throw "Payload is missing server/firstboot/$s." }
        Copy-Item -LiteralPath $src -Destination (Join-Path $td $s)
    }
    $folders = @('server', 'agent', 'client')
    if ((Get $Form 'portalsMode') -eq 'native') { $folders += 'portal' }
    foreach ($f in $folders) {
        $src = Join-Path $PayloadRoot $f
        if (-not (Test-Path -LiteralPath $src)) { throw "Payload folder '$f' is missing from $PayloadRoot." }
        Copy-Item -LiteralPath $src -Destination (Join-Path $td $f) -Recurse
        # Never put local secrets or caches on the media.
        Get-ChildItem -LiteralPath (Join-Path $td $f) -Recurse -Force -File -ErrorAction SilentlyContinue |
            Where-Object { $_.Name -like '.env*' -and $_.Name -ne '.env.example' -or $_.Name -like '*.pyc' } |
            Remove-Item -Force
        Get-ChildItem -LiteralPath (Join-Path $td $f) -Recurse -Force -Directory -ErrorAction SilentlyContinue |
            Where-Object { $_.Name -in @('__pycache__', '.pytest_cache', 'bin', 'obj', 'secrets', 'tests') } |
            Sort-Object { $_.FullName.Length } -Descending | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue
    }
    Get-Item -LiteralPath $OutDir
}

function New-TdMediaZip {
    <# Zips a media folder (autounattend.xml at the zip root). #>
    param([Parameter(Mandatory)][string] $Folder, [Parameter(Mandatory)][string] $ZipPath)
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    if (Test-Path -LiteralPath $ZipPath) { Remove-Item -LiteralPath $ZipPath -Force }
    [IO.Compression.ZipFile]::CreateFromDirectory($Folder, $ZipPath, [IO.Compression.CompressionLevel]::Optimal, $false)
    Get-Item -LiteralPath $ZipPath
}

function New-TdIso {
    <#
    .SYNOPSIS
        Builds an ISO from a folder with the in-box IMAPI2FS COM API (Windows only):
        ISO9660 + Joliet + UDF, volume label TEMPDESK.
    #>
    param([Parameter(Mandatory)][string] $Folder, [Parameter(Mandatory)][string] $IsoPath, [string] $Label = 'TEMPDESK')
    if (-not ($env:OS -eq 'Windows_NT' -or $IsWindows)) { throw 'Building an ISO needs Windows (IMAPI2FS). Use the zip kit on other systems.' }
    $fsi = New-Object -ComObject IMAPI2FS.MsftFileSystemImage
    # FsiFileSystemISO9660 = 1, Joliet = 2, UDF = 4
    $fsi.FileSystemsToCreate = 7
    $fsi.VolumeName = $Label
    $fsi.FreeMediaBlocks = 0
    $fsi.Root.AddTree((Resolve-Path -LiteralPath $Folder).ProviderPath, $false)
    $result = $fsi.CreateResultImage()
    $stream = $result.ImageStream
    if (-not ('TempDesk.IsoWriter' -as [type])) {
        Add-Type -TypeDefinition @'
using System;
using System.IO;
using System.Runtime.InteropServices;
using System.Runtime.InteropServices.ComTypes;
namespace TempDesk {
    public static class IsoWriter {
        public static void Write(object comStream, string path, int blockSize, int blocks) {
            IStream s = (IStream)comStream;
            byte[] buf = new byte[blockSize * 32];
            IntPtr read = Marshal.AllocHGlobal(8);
            try {
                using (FileStream fs = File.Create(path)) {
                    long total = (long)blockSize * blocks;
                    while (total > 0) {
                        int want = (int)Math.Min(buf.Length, total);
                        s.Read(buf, want, read);
                        int got = Marshal.ReadInt32(read);
                        if (got <= 0) break;
                        fs.Write(buf, 0, got);
                        total -= got;
                    }
                }
            } finally { Marshal.FreeHGlobal(read); }
        }
    }
}
'@
    }
    [TempDesk.IsoWriter]::Write($stream, $IsoPath, $result.BlockSize, $result.TotalBlocks)
    [void][Runtime.InteropServices.Marshal]::ReleaseComObject($fsi)
    Get-Item -LiteralPath $IsoPath
}

