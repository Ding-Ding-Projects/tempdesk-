# Copy to .env and fill in. Never commit .env.

# 128-bit key as 32 hexadecimal digits. Generate one with:
#   openssl rand -hex 16
# The TempDesk portal must use the same value (GUAC_JSON_SECRET_KEY).
JSON_SECRET_KEY=

# Port on the LAN where Guacamole is served (http://<this-host>:8090/).
GUAC_PORT=8090

# Address to listen on. 0.0.0.0 means every interface.
GUAC_BIND=0.0.0.0

# Set to true only when a reverse proxy (TLS) sits in front of Guacamole.
REMOTE_IP_VALVE_ENABLED=false

# guacd log level: error, warning, info, debug, trace
GUACD_LOG_LEVEL=info
