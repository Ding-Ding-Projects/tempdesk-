# Copy to .env and edit. Never commit .env or secrets/.

# Active Directory names
REALM=LAB.EXAMPLE.ORG
DOMAIN_FQDN=lab.example.org
NETBIOS=LAB
DC_HOSTNAME=dc1

# The DC's own address on your LAN. Reserve it outside your router's DHCP
# pool so nothing else gets it.
DC_IP=192.168.1.20

# Host network interface the macvlan network attaches to (see "ip link").
LAN_PARENT_IF=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1
# Range Docker may assign from on this network. A /32 of DC_IP is safest.
LAN_IP_RANGE=192.168.1.20/32

# Where the DC sends DNS queries for names outside the domain.
DNS_FORWARDER=1.1.1.1

# Existing account that is added to "TempDesk Admins" on first start.
INITIAL_ADMIN=Administrator

# The Administrator password is NOT set here. Put it in
# secrets/admin_password (one line, 8+ characters, 3 of: upper case, lower
# case, digit, symbol) and keep that file readable only by you:
#   mkdir -p secrets && install -m 600 /dev/null secrets/admin_password
#   nano secrets/admin_password
